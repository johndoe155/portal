# ═══════════════════════════════════════════════════════════════════════════
# School Portal — environment reference
#
# Copy to `.env` and fill in. Everything the stack reads is listed here;
# anything marked REQUIRED makes the API refuse to boot in production.
#
#   cp .env.example .env
#   openssl rand -base64 48      # APP_SECRET
#   openssl rand -base64 32      # BACKUP_ENCRYPTION_KEY
# ═══════════════════════════════════════════════════════════════════════════

# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
# Shown on /health; set to the image tag or git sha at deploy time.
APP_VERSION=dev
# error | warn | debug  (debug is verbose — not for production)
LOG_LEVEL=warn

# REQUIRED in production, >=32 chars, not the dev placeholder.
# Sources the AES-256 PII encryption key AND the SSO-state HMAC key.
# Rotating this invalidates encrypted outbox payloads and TOTP secrets.
APP_SECRET=

# The origin the browser uses. All emailed links are built from this, so a
# wrong value sends people to a dead host.
PUBLIC_WEB_ORIGIN=https://portal.school.example

# ── Database ───────────────────────────────────────────────────────────────
# REQUIRED in production. Without it the API falls back to in-memory PGlite,
# which is FATAL in production (apps/api/src/db/client.ts).
DATABASE_URL=postgres://portal_owner:CHANGE_ME@postgres:5432/portal
DATABASE_POOL_MAX=10
# true for managed Postgres (Neon/Supabase/RDS); false for in-cluster.
DATABASE_SSL=true
# Only set false if your provider uses a self-signed cert you cannot pin.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# docker compose only — password for the bundled postgres service.
POSTGRES_OWNER_PASSWORD=CHANGE_ME

# ── Cookies / proxy ────────────────────────────────────────────────────────
# true everywhere TLS terminates in front of the app. false ONLY for local http.
COOKIE_SECURE=true
# Number of trusted proxy hops so req.ip is the real client (rate limiting and
# audit depend on it). compose topology caddy → web → api = 2.
TRUST_PROXY=2

# ── First admin (bootstrap) ────────────────────────────────────────────────
# Set for the FIRST boot only, then remove. Creates one super_admin, audited.
# Issue their MFA token out of band: node scripts/mfa-token.mjs <email>
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=School Administrator

# ── Email (REQUIRED in production) ─────────────────────────────────────────
# Without SMTP_URL the API refuses to boot in production: previously it fell
# back to a JSON sink and silently discarded every password-reset mail.
# Format: smtps://user:pass@host:465  or  smtp://user:pass@host:587
SMTP_URL=
MAIL_FROM="School Portal <portal@school.example>"
# Optional: where replies should go if different from MAIL_FROM.
MAIL_REPLY_TO=
# Skip the boot-time SMTP verify() handshake (for air-gapped CI only).
SMTP_VERIFY_ON_BOOT=true
# Per-tick delivery batch size for the outbox worker.
MAIL_BATCH_SIZE=50
# Max delivery attempts before a notification is dead-lettered.
MAIL_MAX_ATTEMPTS=6
#
# ⚠ SPF, DKIM and DMARC must be published on the sending domain or this mail
#   lands in spam. Exact DNS records: docs/email-setup.md
#   Verify with: node scripts/mail-check.mjs you@example.com

# ── Web push (optional) ────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:portal@school.example
# Dev only: file to append push payloads to when VAPID is unset.
PUSH_SINK_FILE=data/push-outbox.jsonl

# ── Payments (Paystack) ────────────────────────────────────────────────────
# Webhook returns 503 until this is set. Use the LIVE key in production.
PAYSTACK_SECRET=
PAYSTACK_API_BASE=https://api.paystack.co
# How long a pending checkout is reused before a fresh reference is minted.
PAYSTACK_CHECKOUT_TTL_MS=1800000

# ── Worker ─────────────────────────────────────────────────────────────────
# "false" in production: run the worker as its own process (compose does this).
# Leaving it true runs the outbox in-process, which does not scale past one node.
WORKER_INPROC=false
WORKER_INTERVAL_MS=5000
# Daily retention purge (see docs/legal/data-retention.md). 0 disables.
RETENTION_PURGE_ENABLED=true
RETENTION_PURGE_HOUR_UTC=2

# ── Backups ────────────────────────────────────────────────────────────────
# REQUIRED for scripts/backup.sh. Dumps are AES-256 encrypted before upload.
# Losing this key means losing every backup — store it in a password manager,
# NOT in the same place as the backups.
BACKUP_ENCRYPTION_KEY=
# S3-compatible target (Cloudflare R2, AWS S3, Backblaze B2).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Days to keep, locally and remotely. Runbook commits to 35.
BACKUP_RETENTION_DAYS=35
# Local staging directory for dumps before upload.
BACKUP_DIR=./backups

# ── Imports ────────────────────────────────────────────────────────────────
# Max roster CSV upload size. Applies ONLY to /import/* — the rest of the API
# stays capped at 1 MB of JSON.
IMPORT_MAX_UPLOAD_MB=25
# Rows per transaction when the worker processes an import job.
IMPORT_BATCH_SIZE=200
# Temp directory for streamed uploads.
IMPORT_TMP_DIR=./data/imports

# ── Security / MFA ─────────────────────────────────────────────────────────
# Staff MFA step-up. NEVER set false in production.
MFA_ENFORCE=true
# Sliding-window rate limits. Per-IP caps are generous because a whole school
# shares one NAT address; the tight limits are per-account.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_IP_MAX=500
RATE_LIMIT_TOTP_MAX=10
RATE_LIMIT_FORGOT_EMAIL_MAX=3
RATE_LIMIT_ACCT_OPS_IP_MAX=100
RATE_LIMIT_GENERAL_MAX=100

# ── SSO (optional) ─────────────────────────────────────────────────────────
# Pattern: SSO_<NAME>_{ISSUER,AUTH_URL,TOKEN_URL,CLIENT_ID,CLIENT_SECRET,
#                      SCOPES,JWKS_URL,JIT_ROLE,REQUIRE_EMAIL_VERIFIED}
#
# Microsoft Entra ID — use your SINGLE-TENANT issuer. 'common'/'organizations'
# accept any Microsoft account and are refused when email_verified is exempted.
# SSO_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SSO_ENTRA_AUTH_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
# SSO_ENTRA_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
# SSO_ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# SSO_ENTRA_CLIENT_ID=
# SSO_ENTRA_CLIENT_SECRET=
# Entra does not emit email_verified; Google always does.
# SSO_ENTRA_REQUIRE_EMAIL_VERIFIED=false
# SSO_ENTRA_JIT_ROLE=teacher
#
# Google Workspace
# SSO_GOOGLE_ISSUER=https://accounts.google.com
# SSO_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# SSO_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# SSO_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
#
# Allows HS256 mock-IdP tokens. Production refuses to boot with these unless
# this is "true". Never enable it for a real school.
SSO_ALLOW_INSECURE=false

# ── Web / ingress ──────────────────────────────────────────────────────────
# Internal API address for the Next BFF rewrite (server-side only).
API_INTERNAL=http://api:8080
# Domain Caddy obtains an ACME certificate for. "localhost" uses its internal CA.
PORTAL_DOMAIN=portal.school.example

# ── Dev only — never set these in production ───────────────────────────────
# The API refuses to boot with SEED_DEMO=true in production.
# SEED_DEMO=true
# PGLITE_DATA_DIR=./data/pglite
